    {
      "cell_type": "markdown",
      "source": [
        "\n",
        "Step-1 Tokenization: Convert words into tokens (mathematical numbers), it also varies from model to model\n"
      ],
      "metadata": {
        "id": "NmkfAIlGB7Og"
      }
    },
    {
      "cell_type": "code",
      "source": [
        "from transformers import AutoTokenizer\n",
        "\n",
        "tokenizer = AutoTokenizer.from_pretrained(\"google/gemma-3-1b-it\")\n",
        "tokenizer(\"Hey There!, My name is aditya\")"
